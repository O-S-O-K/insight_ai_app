# Example Streamlit secrets configuration
# Copy this file to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to version control!

# Backend URL for the FastAPI service
# For local development: http://localhost:8000
# For Render deployment: https://your-service-name.onrender.com
INSIGHT_BACKEND_URL = "http://localhost:8000"

# Optional: Hugging Face token for BLIP captioning via HF API
# Not needed if running BLIP locally on the backend
# HF_TOKEN = "your_huggingface_token_here"
