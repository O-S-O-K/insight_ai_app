# =============================================================================
# Insight AI - Environment Variables Template
# =============================================================================
# Copy this file to .env and configure for your environment
# Never commit .env with real credentials to version control

# -----------------------------------------------------------------------------
# Frontend Configuration (Streamlit App)
# -----------------------------------------------------------------------------

# Backend API URL - where the FastAPI service is running
# Local development:  http://localhost:7860
# Hugging Face Spaces: https://your-username-insight-ai-backend.hf.space
# Render.com (legacy): https://your-backend.onrender.com
INSIGHT_BACKEND_URL=http://localhost:7860

# Use mock API for testing without backend (true/false)
# Set to "true" for frontend-only development
USE_MOCK_API=false

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI Service)
# -----------------------------------------------------------------------------

# Enable BLIP image captioning model (true/false)
# Set to "false" on low-memory environments (Render free tier: 512MB RAM)
# HF Spaces free tier (16GB RAM) can safely keep this true
ENABLE_BLIP=true

# Enable SHAP explainability (true/false)
# Requires ~300MB RAM above base model. Default: true on HF Spaces.
ENABLE_SHAP=true

# Enable CLIP zero-shot classification (true/false)
# Requires ~600MB RAM for CLIP ViT-B/32. Default: true on HF Spaces.
ENABLE_CLIP=true

# Active learning confidence threshold (0.0 - 1.0)
# Predictions below this confidence are auto-flagged for human review
ACTIVE_LEARNING_THRESHOLD=0.5

# Model type to serve (imagenet | medical)
# imagenet: MobileNetV2 pretrained on ImageNet-1K (1000 classes)
# medical:  EfficientNetB0 fine-tuned on ISIC skin lesion dataset (2 classes)
MODEL_TYPE=imagenet

# Hugging Face token (required for BLIP and CLIP model downloads)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# -----------------------------------------------------------------------------
# TensorFlow / Keras Configuration
# -----------------------------------------------------------------------------

# Force CPU execution (disable GPU)
# Set to "-1" to use CPU only, remove or set to "" to use GPU if available
CUDA_VISIBLE_DEVICES=-1

# TensorFlow logging level
# 0 = all logs, 1 = filter INFO, 2 = filter WARNING, 3 = filter ERROR
TF_CPP_MIN_LOG_LEVEL=2

# Use legacy Keras 2.x API bundled with TensorFlow
# Set to "1" for compatibility with TensorFlow 2.15.x models
TF_USE_LEGACY_KERAS=1

# -----------------------------------------------------------------------------
# MLflow Configuration
# -----------------------------------------------------------------------------

# MLflow tracking URI (local file or remote server)
# Local:  file:./mlruns  (default, no server needed)
# Remote: http://your-mlflow-server:5000
MLFLOW_TRACKING_URI=file:./mlruns

# MLflow experiment name
MLFLOW_EXPERIMENT_NAME=insight-ai-inference

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------

# Port for FastAPI backend
# HF Spaces default: 7860
# Render: automatically provided as $PORT
# Local: 7860
PORT=7860

# Port for Streamlit frontend (default: 8501)
# STREAMLIT_SERVER_PORT=8501
